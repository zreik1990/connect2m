<!-- connect2m: override connect2m.ini from install properties, so the client
     MSI can be deployed with a per-batch password/server/key, e.g.
       msiexec /i connect2m-Client.msi C2M_PASSWORD=Secret /qn
     Without a property, the value baked into the payload by the build stays.
     Copyright (c) 2026 Abdallah Zreik. AGPL-3.0. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<?include ../Includes.wxi?>

	<Fragment>
		<Property Id="C2M_SERVER" Secure="yes" />
		<Property Id="C2M_KEY" Secure="yes" />
		<Property Id="C2M_PASSWORD" Secure="yes" Hidden="yes" />
		<Property Id="C2M_API" Secure="yes" />

		<DirectoryRef Id="INSTALLFOLDER_INNER">
			<Component Id="Connect2m.Settings.Server" Guid="7B3A1E90-11CC-4E71-8E2A-1C0D5B7A9001" Condition="C2M_SERVER">
				<IniFile Id="C2mIniServer" Action="createLine" Directory="INSTALLFOLDER_INNER"
					Name="connect2m.ini" Section="connect2m" Key="server" Value="[C2M_SERVER]" />
				<RegistryValue Root="HKLM" Key="Software\$(var.Product)\Connect2m" Name="server" Type="string" Value="[C2M_SERVER]" KeyPath="yes" />
			</Component>
			<Component Id="Connect2m.Settings.Key" Guid="7B3A1E90-11CC-4E71-8E2A-1C0D5B7A9002" Condition="C2M_KEY">
				<IniFile Id="C2mIniKey" Action="createLine" Directory="INSTALLFOLDER_INNER"
					Name="connect2m.ini" Section="connect2m" Key="key" Value="[C2M_KEY]" />
				<RegistryValue Root="HKLM" Key="Software\$(var.Product)\Connect2m" Name="key" Type="string" Value="[C2M_KEY]" KeyPath="yes" />
			</Component>
			<Component Id="Connect2m.Settings.Api" Guid="7B3A1E90-11CC-4E71-8E2A-1C0D5B7A9003" Condition="C2M_API">
				<IniFile Id="C2mIniApi" Action="createLine" Directory="INSTALLFOLDER_INNER"
					Name="connect2m.ini" Section="connect2m" Key="api" Value="[C2M_API]" />
				<RegistryValue Root="HKLM" Key="Software\$(var.Product)\Connect2m" Name="api" Type="string" Value="[C2M_API]" KeyPath="yes" />
			</Component>
			<!-- Plain password here; the service replaces it with a hash on first start. -->
			<Component Id="Connect2m.Settings.Password" Guid="7B3A1E90-11CC-4E71-8E2A-1C0D5B7A9004" Condition="C2M_PASSWORD">
				<IniFile Id="C2mIniPassword" Action="createLine" Directory="INSTALLFOLDER_INNER"
					Name="connect2m.ini" Section="connect2m" Key="password" Value="[C2M_PASSWORD]" />
				<RegistryValue Root="HKLM" Key="Software\$(var.Product)\Connect2m" Name="pwset" Type="integer" Value="1" KeyPath="yes" />
			</Component>
		</DirectoryRef>
	</Fragment>
</Wix>
