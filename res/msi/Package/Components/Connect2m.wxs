<!-- connect2m install-time settings. Copyright (c) 2026 Abdallah Zreik. AGPL-3.0.

     msiexec /i connect2m-Client.msi C2M_SERVER=192.168.1.10 C2M_KEY=<server key> C2M_PASSWORD=<password> /qn

     Each property, when given, is written into connect2m.ini next to the app.
     The app replaces a plain password by its hash when its service starts. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<?include ../Includes.wxi?>

	<Fragment>
		<Property Id="C2M_SERVER" Secure="yes" />
		<Property Id="C2M_KEY" Secure="yes" />
		<Property Id="C2M_PASSWORD" Secure="yes" Hidden="yes" />

		<DirectoryRef Id="INSTALLFOLDER_INNER">
			<Component Id="Connect2m.Settings.Server" Guid="0E4D3A52-8C1B-4F7A-9B3E-6A2D1C5F7E01" Condition="C2M_SERVER">
				<IniFile Id="Connect2m.Ini.Server" Action="addLine" Directory="INSTALLFOLDER_INNER" Name="connect2m.ini" Section="connect2m" Key="server" Value="[C2M_SERVER]" />
				<RegistryValue Root="HKLM" Key="Software\$(var.Product)\Settings" Name="server" Type="integer" Value="1" KeyPath="yes" />
			</Component>
			<Component Id="Connect2m.Settings.Key" Guid="0E4D3A52-8C1B-4F7A-9B3E-6A2D1C5F7E02" Condition="C2M_KEY">
				<IniFile Id="Connect2m.Ini.Key" Action="addLine" Directory="INSTALLFOLDER_INNER" Name="connect2m.ini" Section="connect